import java.util.*;

public class FoodChainManagement {

    // ---------------- SEGMENT TREE ----------------
    static class SegmentTree {
        int[] tree;
        int n;

        SegmentTree(int[] arr) {
            n = arr.length;
            tree = new int[4 * n];
            build(arr, 0, 0, n - 1);
        }

        void build(int[] arr, int node, int start, int end) {
            if (start == end) {
                tree[node] = arr[start];
            } else {
                int mid = (start + end) / 2;
                build(arr, 2 * node + 1, start, mid);
                build(arr, 2 * node + 2, mid + 1, end);
                tree[node] = tree[2 * node + 1] + tree[2 * node + 2];
            }
        }

        int query(int node, int start, int end, int l, int r) {
            if (r < start || end < l)
                return 0;

            if (l <= start && end <= r)
                return tree[node];

            int mid = (start + end) / 2;

            return query(2 * node + 1, start, mid, l, r)
                    + query(2 * node + 2, mid + 1, end, l, r);
        }

        int rangeQuery(int l, int r) {
            return query(0, 0, n - 1, l, r);
        }
    }

    // ---------------- FENWICK TREE ----------------
    static class FenwickTree {
        int[] bit;
        int n;

        FenwickTree(int size) {
            n = size;
            bit = new int[n + 1];
        }

        void update(int index, int value) {
            index++;
            while (index <= n) {
                bit[index] += value;
                index += index & (-index);
            }
        }

        int query(int index) {
            index++;
            int sum = 0;
            while (index > 0) {
                sum += bit[index];
                index -= index & (-index);
            }
            return sum;
        }
    }

    // ---------------- MAIN ----------------
    public static void main(String[] args) {

        // B-Tree Concept (Restaurant Index)
        TreeSet<Integer> restaurantIDs = new TreeSet<>();

        restaurantIDs.add(101);
        restaurantIDs.add(105);
        restaurantIDs.add(110);
        restaurantIDs.add(115);
        restaurantIDs.add(120);

        System.out.println("===== B-Tree Restaurant Index =====");
        System.out.println("Restaurant IDs: " + restaurantIDs);

        int searchRestaurant = 110;

        if (restaurantIDs.contains(searchRestaurant))
            System.out.println("Restaurant Found: " + searchRestaurant);
        else
            System.out.println("Restaurant Not Found");

        // B+ Tree Concept (Order Index)
        TreeSet<Integer> orderIDs = new TreeSet<>();

        orderIDs.add(1001);
        orderIDs.add(1005);
        orderIDs.add(1010);
        orderIDs.add(1015);
        orderIDs.add(1020);

        System.out.println("\n===== B+ Tree Order Index =====");
        System.out.println("Order IDs: " + orderIDs);

        System.out.println("Orders between 1005 and 1015:");

        for (Integer order :
                orderIDs.subSet(1005, true, 1015, true)) {
            System.out.print(order + " ");
        }

        // Segment Tree Revenue Analysis
        int[] revenue = {5000, 6500, 4500, 7000, 8000};

        SegmentTree segmentTree = new SegmentTree(revenue);

        System.out.println("\n\n===== Segment Tree Revenue Analysis =====");

        int totalRevenue = segmentTree.rangeQuery(1, 4);

        System.out.println("Revenue from Day 2 to Day 5 = "
                + totalRevenue);

        // Fenwick Tree Order Statistics
        int[] orders = {50, 70, 40, 90, 80};

        FenwickTree fenwick = new FenwickTree(orders.length);

        for (int i = 0; i < orders.length; i++) {
            fenwick.update(i, orders[i]);
        }

        System.out.println("\n===== Fenwick Tree Order Statistics =====");

        System.out.println("Orders till Day 4 = "
                + fenwick.query(3));

        System.out.println("Orders till Day 5 = "
                + fenwick.query(4));

        // Complexity Report
        System.out.println("\n===== Time Complexity =====");

        System.out.println("B-Tree Search     : O(log n)");
        System.out.println("B+ Tree Range Query: O(log n + k)");
        System.out.println("Segment Tree Query : O(log n)");
        System.out.println("Fenwick Tree Query : O(log n)");
    }
}