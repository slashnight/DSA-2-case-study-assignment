import java.util.*;

public class FoodChainAVL {

    static class Node {
        int key;
        int height;
        Node left, right;

        Node(int key) {
            this.key = key;
            this.height = 1;
        }
    }

    Node root;
    static List<String> rotationLog = new ArrayList<>();

    // Height
    int height(Node n) {
        return (n == null) ? 0 : n.height;
    }

    // Balance Factor
    int getBalance(Node n) {
        return (n == null) ? 0 : height(n.left) - height(n.right);
    }

    // Right Rotation (LL)
    Node rightRotate(Node y) {
        Node x = y.left;
        Node t2 = x.right;

        x.right = y;
        y.left = t2;

        y.height = Math.max(height(y.left), height(y.right)) + 1;
        x.height = Math.max(height(x.left), height(x.right)) + 1;

        rotationLog.add("LL Rotation at pivot " + y.key);

        return x;
    }

    // Left Rotation (RR)
    Node leftRotate(Node x) {
        Node y = x.right;
        Node t2 = y.left;

        y.left = x;
        x.right = t2;

        x.height = Math.max(height(x.left), height(x.right)) + 1;
        y.height = Math.max(height(y.left), height(y.right)) + 1;

        rotationLog.add("RR Rotation at pivot " + x.key);

        return y;
    }

    // AVL Insert
    Node insert(Node node, int key) {

        if (node == null)
            return new Node(key);

        if (key < node.key)
            node.left = insert(node.left, key);
        else if (key > node.key)
            node.right = insert(node.right, key);
        else
            return node;

        node.height = 1 + Math.max(height(node.left), height(node.right));

        int balance = getBalance(node);

        // LL
        if (balance > 1 && key < node.left.key)
            return rightRotate(node);

        // RR
        if (balance < -1 && key > node.right.key)
            return leftRotate(node);

        // LR
        if (balance > 1 && key > node.left.key) {
            rotationLog.add("LR Rotation at pivot " + node.key);
            node.left = leftRotate(node.left);
            return rightRotate(node);
        }

        // RL
        if (balance < -1 && key < node.right.key) {
            rotationLog.add("RL Rotation at pivot " + node.key);
            node.right = rightRotate(node.right);
            return leftRotate(node);
        }

        return node;
    }

    // Search Path
    void searchPath(Node root, int key) {
        Node current = root;

        while (current != null) {
            System.out.print(current.key);

            if (current.key == key) {
                System.out.println("  -> FOUND");
                return;
            }

            System.out.print(" -> ");

            if (key < current.key)
                current = current.left;
            else
                current = current.right;
        }

        System.out.println("NOT FOUND");
    }

    // Reverse Inorder (Descending)
    void descending(Node root) {
        if (root == null)
            return;

        descending(root.right);
        System.out.print(root.key + " ");
        descending(root.left);
    }

    // Tree Printer
    void printTree(Node root, int space) {

        if (root == null)
            return;

        space += 10;

        printTree(root.right, space);

        System.out.println();

        for (int i = 10; i < space; i++)
            System.out.print(" ");

        System.out.print(root.key + "(BF=" + getBalance(root) + ")");

        printTree(root.left, space);
    }

    public static void main(String[] args) {

        FoodChainAVL tree = new FoodChainAVL();

        int[] records = {
                45, 25, 60, 15, 35,
                55, 75, 10, 20
        };

        System.out.println("==============================================");
        System.out.println("FOODCHAIN BACKEND RESTAURANT INDEX MANAGEMENT");
        System.out.println("AVL TREE IMPLEMENTATION");
        System.out.println("==============================================");

        System.out.println("\nAVL INSERTION (Restaurant Records)\n");

        System.out.print("Insertion Order:\n");
        for (int i = 0; i < records.length; i++) {
            System.out.print(records[i]);
            if (i != records.length - 1)
                System.out.print(", ");
        }

        System.out.println("\n");

        for (int value : records) {
            tree.root = tree.insert(tree.root, value);
        }

        System.out.println("Rotations that occurred:");

        if (rotationLog.isEmpty()) {
            System.out.println("No rotations required.");
            System.out.println("AVL remained balanced after every insertion.");
        } else {
            for (int i = 0; i < rotationLog.size(); i++) {
                System.out.println((i + 1) + ") " + rotationLog.get(i));
            }
        }

        System.out.println("\nFINAL AVL TREE\n");

        tree.printTree(tree.root, 0);

        System.out.println("\n\nSEARCH OPERATIONS\n");

        System.out.print("Search Restaurant ID 35 : ");
        tree.searchPath(tree.root, 35);

        System.out.print("Search Restaurant ID 55 : ");
        tree.searchPath(tree.root, 55);

        System.out.println("\nRESTAURANT IDS IN DESCENDING ORDER\n");

        tree.descending(tree.root);

        System.out.println("\n");

        System.out.println("\nPERFORMANCE ANALYSIS\n");

        System.out.println("Search Time      : O(log n)");
        System.out.println("Insertion Time   : O(log n)");
        System.out.println("Deletion Time    : O(log n)");
        System.out.println("Rotation Cost    : O(1)");
        System.out.println("Worst Case BST   : O(n)");
        System.out.println("AVL Height       : O(log n)");

        System.out.println("\nCONCLUSION");
        System.out.println("AVL Tree provides efficient restaurant");
        System.out.println("record indexing, menu searching,");
        System.out.println("delivery record management, and");
        System.out.println("guaranteed O(log n) performance.");

        System.out.println("\nProcess finished with exit code 0");
    }
}